              "pm.test('Status 401', () => pm.response.to.have.status(401));",
              "pm.test('JSON explicativo', () => pm.expect(pm.response.json()).to.have.property('mensaje'));",
              "pm.test('NO trae X-Servidor-Procesado', () => pm.response.to.not.have.header('X-Servidor-Procesado'));"
            ]
          }
        }
      ],
      "request": {
