    {
      "name": "6. Verificar headers de respuesta (CORS + personalizado)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Access-Control-Allow-Origin = origen permitido', () => {",
              "  pm.expect(pm.response.headers.get('Access-Control-Allow-Origin')).to.eql('http://localhost:5500');",
              "});",
              "pm.test('X-Servidor-Procesado = Equipo-N', () => {",
              "  pm.expect(pm.response.headers.get('X-Servidor-Procesado')).to.match(/^Equipo-/);",
              "});",
              "pm.test('Content-Type es JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Red-Equipo",
            "value": "{{teamHeader}}"
          },
          {
            "key": "Origin",
            "value": "{{origin}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/envios",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "envios"
          ]
        }
      },
      "response": []
    }
  ],
