{
  "info": {
    "_postman_id": "9f20fa58-d2f0-4107-be46-882c855ee3be",
    "name": "Servicio Envíos CIAF",
    "description": "Pruebas del servicio Express: header X-Red-Equipo, CORS y headers de respuesta. Cambiar la variable de colección teamHeader a CIAF-N (con el N real del equipo).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "49377876",
    "_collection_link": "https://go.postman.co/collection/49377876-9f20fa58-d2f0-4107-be46-882c855ee3be?source=collection_link"
  },
  "item": [
    {
      "name": "1. GET envíos - válida (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Responde JSON con data', () => pm.expect(pm.response.json()).to.have.property('data'));",
              "pm.test('Trae X-Servidor-Procesado', () => pm.response.to.have.header('X-Servidor-Procesado'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Red-Equipo",
            "value": "{{teamHeader}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/envios",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "envios"
          ]
        }
      },
      "response": []
    },
    {
      "name": "2. POST envío - válida (201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "pm.test('Devuelve el envío creado', () => pm.expect(pm.response.json().data).to.have.property('guia'));",
              "pm.test('Trae X-Servidor-Procesado', () => pm.response.to.have.header('X-Servidor-Procesado'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Red-Equipo",
            "value": "{{teamHeader}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"guia\": \"ENV-2001\",\n  \"destino\": \"Medellín\",\n  \"estado\": \"En bodega\"\n}"
